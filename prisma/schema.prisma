generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  BLAZER
  JUMPER
  SKIRT
  TROUSERS
  SHIRT
  TIE
  PE_KIT
  SHOES
  COAT
  TRACKSUIT
  OTHER
}

enum Gender {
  BOYS
  GIRLS
  UNISEX
}

enum Condition {
  AS_NEW
  GOOD
  FAIR
}

enum ListingType {
  SALE
  DONATION
}

enum ListingStatus {
  ACTIVE
  RESERVED
  COMPLETED
  REMOVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model School {
  id        String    @id @default(uuid())
  name      String
  users     User[]
  listings  Listing[]
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  schoolId     String
  isAdmin      Boolean       @default(false)
  school       School        @relation(fields: [schoolId], references: [id])
  listings     Listing[]
  reservations Reservation[]
}

model Listing {
  id           String         @id @default(uuid())
  sellerId     String
  schoolId     String
  itemType     ItemType
  gender       Gender
  size         String
  condition    Condition
  listingType  ListingType
  priceInPence Int
  status       ListingStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  seller       User           @relation(fields: [sellerId], references: [id])
  school       School         @relation(fields: [schoolId], references: [id])
  images       ListingImage[]
  reservations Reservation[]
}

model ListingImage {
  id         String  @id @default(uuid())
  listingId  String
  url        String
  sortOrder  Int
  
  listing    Listing @relation(fields: [listingId], references: [id])
}

model Reservation {
  id          String            @id @default(uuid())
  listingId   String
  buyerId     String
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime          @default(now())
  
  listing     Listing           @relation(fields: [listingId], references: [id])
  buyer       User              @relation(fields: [buyerId], references: [id])
}
