datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model School {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id])
  createdAt     DateTime        @default(now())
  listings      Listing[]       @relation("SellerListings")
  reservations  Reservation[]   @relation("BuyerReservations")
  messages      Message[]       @relation("UserMessages")
  buyerThreads  MessageThread[] @relation("BuyerThreads")
  sellerThreads MessageThread[] @relation("SellerThreads")
}

model Listing {
  id             String          @id @default(cuid())
  sellerId       String
  seller         User            @relation("SellerListings", fields: [sellerId], references: [id])
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  itemType       String          // BLAZER, JUMPER, SKIRT, TROUSERS, SHIRT, TIE, PE_KIT, SHOES, COAT, TRACKSUIT, OTHER
  gender         String          // BOYS, GIRLS, UNISEX
  size           String
  condition      String          // AS_NEW, GOOD, FAIR
  listingType    String          // SALE, DONATION
  priceInPence   Int             @default(0)
  status         String          @default("ACTIVE") // ACTIVE, RESERVED, COMPLETED, REMOVED
  images         ListingImage[]
  reservations   Reservation[]
  messageThreads MessageThread[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
}

model Reservation {
  id            String         @id @default(cuid())
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User           @relation("BuyerReservations", fields: [buyerId], references: [id])
  status        String         @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  messageThread MessageThread?
  createdAt     DateTime       @default(now())
}

model MessageThread {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User        @relation("BuyerThreads", fields: [buyerId], references: [id])
  sellerId      String
  seller        User        @relation("SellerThreads", fields: [sellerId], references: [id])
  isClosed      Boolean     @default(false)
  messages      Message[]
  createdAt     DateTime    @default(now())
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("UserMessages", fields: [senderId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}
